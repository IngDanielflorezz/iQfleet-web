# Copia este archivo como .env.local (no se sube al repo).
# URL de la API en C# (carpeta api/). El acceso se autoriza con el JWT del login,
# así que el front ya no necesita ningún token fijo.
VITE_API_URL=http://localhost:8080

# API Key de TomTom (mapas y cálculo de rutas en Monitoreo GPS).
# Queda visible en el navegador: restríngela por dominio en el panel de TomTom.
# Si se deja vacía, el mapa usa OpenStreetMap/CARTO y no traza rutas.
VITE_TOMTOM_API_KEY=
