# Copia este archivo como api/.env (no se sube al repo) y completa los valores.

# --- Opción A: Supabase ---
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# IQFLEET_DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Opción B: Postgres local (docker compose --profile local up --build) ---
# La clave debe ser la misma en POSTGRES_PASSWORD y en la URL.
POSTGRES_PASSWORD=cambia-esta-clave
IQFLEET_DATABASE_URL=postgresql://postgres:cambia-esta-clave@db:5432/postgres

# Token que el front envía en  Authorization: Bearer <token>.
# Debe ser el mismo valor de VITE_API_TOKEN en el .env.local del front.
IQFLEET_API_TOKEN=cambia-este-token-por-uno-largo

# Máximo de conexiones del pool de Npgsql.
IQFLEET_DB_POOL=4
